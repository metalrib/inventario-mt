rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir leitura e escrita em todas as coleções do inventário e catálogo
    match /inventario/{docId} {
      allow read, write: if true;
    }
    match /inventario_bumpers/{docId} {
      allow read, write: if true;
    }
    match /inventario_geral/{docId} {
      allow read, write: if true;
    }
    match /catalogo_produtos/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
